# Template for environment variables. Copy to .env and fill in your values.

# Standard PostgreSQL Variables
PGUSER=
PGPASSWORD=
PGDATABASE=
PGHOST=
PGPORT=

# Time zone for both containers (IANA name, e.g. America/New_York). The server works out "today" and
# Cashflow period boundaries in this zone, so set it to where you live. Defaults to UTC if unset.
TZ=

# Proxy Settings
TRUST_FIRST_PROXY=true

# Session Settings
SESSION_SECRET=
COOKIE_SECURE=false         # Set to 'true' only if serving over HTTPS. On a local HTTP network, leave as 'false'.

# Default App User
SEED_USER_USERNAME=
SEED_USER_PASSWORD=
SEED_USER_DISPLAY_NAME=

# Logging (Options: ignore, console, database)
LOG_LEVEL_ERROR=database
LOG_LEVEL_WARN=console
LOG_LEVEL_INFO=console
