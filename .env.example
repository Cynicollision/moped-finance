# Template for environment variables. Copy to .env and fill in your values.

# Standard PostgreSQL Variables
PGUSER=
PGPASSWORD=
PGDATABASE=
PGHOST=
PGPORT=

# Time zone for both containers (IANA name, e.g. America/New_York). The server works out "today" and
# Spending period boundaries in this zone, so set it to where you live. Defaults to UTC if unset.
TZ=

# HTTP or HTTPS (see docs/deployment.md). The defaults suit plain HTTP on a local network.
# USE_HTTPS: 'true' only when users reach the app over HTTPS through a reverse proxy. It makes the session
# cookie HTTPS-only and turns on HTTPS-only security headers (HSTS), so the app won't work over plain HTTP.
USE_HTTPS=false
# TRUST_FIRST_PROXY: 'true' only when a reverse proxy sits in front of the app. The server then believes the
# proxy's X-Forwarded-* headers for the client's address and protocol; without a proxy, clients could fake them.
TRUST_FIRST_PROXY=false

# Sign-in protection (AUTH-10). Optional: after SIGN_IN_MAX_FAILED_ATTEMPTS failed sign-ins (3-10, default 5) from one
# address within SIGN_IN_WINDOW_MINUTES (5-60, default 15), that address is refused for SIGN_IN_LOCKOUT_MINUTES (5-60,
# default 15). The server won't start with a value out of range. Restarting the server clears every lockout.
SIGN_IN_MAX_FAILED_ATTEMPTS=
SIGN_IN_WINDOW_MINUTES=
SIGN_IN_LOCKOUT_MINUTES=

# Session secret. Optional: leave empty and the server generates one on first start and keeps it in the database.
SESSION_SECRET=

# Default App User
SEED_USER_USERNAME=
SEED_USER_PASSWORD=
SEED_USER_DISPLAY_NAME=

# Logging (Options: ignore, console, database)
LOG_LEVEL_ERROR=database
LOG_LEVEL_WARN=console
LOG_LEVEL_INFO=console
