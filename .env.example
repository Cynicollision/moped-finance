# Template for environment variables. Copy to .env and fill in your values.

# Standard PostgreSQL Variables
PGUSER=
PGPASSWORD=
PGDATABASE=
PGHOST=
PGPORT=

# Secrets
SESSION_SECRET=

# Default App User
SEED_USER_USERNAME=
SEED_USER_PASSWORD=
SEED_USER_DISPLAY_NAME=

# Logging (Options: ignore, console, database)
LOG_LEVEL_ERROR=database
LOG_LEVEL_WARN=console
LOG_LEVEL_INFO=console

# National Weather Service (NWS) API
# Get these by calling: curl -A "HomeLab (your_email@example.com)" https://api.weather.gov/points/YOUR_LATITUDE,YOUR_LONGITUDE
# Extract the values from properties.office (NWS_OFFICE), properties.gridX, and properties.gridY
NWS_OFFICE=
NWS_GRID_X=
NWS_GRID_Y=
NWS_BASE_URL=https://api.weather.gov
NWS_USER_AGENT="HomeLab (your_email@example.com)"

# Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.5-flash