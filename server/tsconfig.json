{
    "compilerOptions": {
        "target": "ES2020",
        "module": "node20",
        "rootDir": "./..",
        "outDir": "./dist",
        "paths": {
            "@shared/*": [
                "./../shared/*"
            ],
            "@server/*": [
                "./src/*"
            ]
        },
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "isolatedModules": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "types": [
            "node",
            "jest"
        ]
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}