# This Dockerfile is for the DEVELOPMENT environment.
# It installs all dependencies (including devDependencies) and relies on a
# volume mount from docker-compose to bring in the source code for hot-reloading.

FROM node:22-alpine

WORKDIR /app

# Explicitly set the environment to development to ensure devDependencies are installed.
ENV NODE_ENV=development

# Copy package definitions and install dependencies.
# This is a separate layer to leverage Docker's build cache.
COPY package*.json ./
RUN npm ci

# The command to run the application is specified in the docker-compose.yml file.