{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --legacy-watch",
    "db:init": "ts-node -r dotenv/config scripts/init-db.ts dotenv_config_path=../.env",
    "db:wipe": "ts-node -r dotenv/config scripts/reset-db.ts dotenv_config_path=../.env",
    "db:seed": "ts-node -r tsconfig-paths/register -r dotenv/config scripts/seed-db.ts dotenv_config_path=../.env",
    "db:reset": "npm run db:wipe && npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^20.11.20",
    "@types/pg": "^8.11.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
