{
    "name": "moped-finance-server",
    "version": "1.0.0",
    "main": "dist/server/index.js",
    "scripts": {
        "build": "tsc && tsc-alias",
        "build:prod": "tsc --project tsconfig.prod.json && tsc-alias --project tsconfig.prod.json",
        "dev": "nodemon --legacy-watch",
        "reset-password": "node dist/server/reset-password.js",
        "reset-password:dev": "cross-env TS_NODE_FILES=true node --env-file-if-exists=../.env -r ts-node/register -r tsconfig-paths/register reset-password.ts",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "node --env-file-if-exists=../.env -r ts-node/register -r tsconfig-paths/register scripts/migrate-db.ts",
        "db:drop": "node --env-file-if-exists=../.env -r ts-node/register scripts/drop-db.ts",
        "db:seed": "npm run db:seed:core && npm run db:seed:finance",
        "db:seed:core": "node --env-file-if-exists=../.env -r ts-node/register -r tsconfig-paths/register scripts/seed-core-db.ts",
        "db:seed:finance": "node --env-file-if-exists=../.env -r ts-node/register -r tsconfig-paths/register scripts/seed-finance-db.ts",
        "db:reset": "npm run db:drop && npm run db:migrate && npm run db:seed",
        "lint": "eslint . ../shared",
        "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
        "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "connect-pg-simple": "^10.0.0",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "express": "^5.3.0",
        "express-session": "^1.19.0",
        "helmet": "^8.3.0",
        "multer": "^2.1.1",
        "papaparse": "^5.5.3",
        "pg": "^8.11.3",
        "short-unique-id": "^5.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.2",
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/connect-pg-simple": "^7.0.3",
        "@types/express": "^5.0.6",
        "@types/express-session": "^1.18.2",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.1.0",
        "@types/node": "^24.19.2",
        "@types/papaparse": "^5.5.2",
        "@types/pg": "^8.11.0",
        "@types/supertest": "^7.2.0",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.11",
        "eslint": "^10.12.0",
        "jest": "^30.3.0",
        "nodemon": "^3.1.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.9",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.9.5",
        "tsconfig-paths": "^4.2.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.59.2"
    }
}
